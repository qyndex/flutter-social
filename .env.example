# Flutter Social — Environment Configuration
# Copy to .env and fill in values before running.

# Supabase project URL (e.g., http://127.0.0.1:54321 for local dev)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase anonymous/public key (safe to embed in client apps)
SUPABASE_ANON_KEY=your-anon-key-here

# Deep-link scheme (used by GoRouter for universal links)
DEEP_LINK_SCHEME=fluttersocial

# Feature flags
ENABLE_IMAGE_UPLOAD=true
ENABLE_PUSH_NOTIFICATIONS=false
