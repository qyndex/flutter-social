# Flutter Social — Environment Configuration
# Copy to .env and fill in values before running.

# Backend API base URL
API_BASE_URL=https://api.example.com

# Authentication token (JWT or API key)
API_AUTH_TOKEN=

# Image CDN / storage bucket URL (optional, for user uploads)
IMAGE_CDN_URL=

# Sentry DSN for crash reporting (optional)
SENTRY_DSN=

# Deep-link scheme (used by GoRouter for universal links)
DEEP_LINK_SCHEME=fluttersocial

# Feature flags
ENABLE_IMAGE_UPLOAD=true
ENABLE_PUSH_NOTIFICATIONS=false
